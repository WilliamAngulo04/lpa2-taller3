# Copiar como .env y ajustar los valores
# Entorno: development | testing | production
ENVIRONMENT=development
DATABASE_URL=sqlite:///./musica.db
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_FILE=musica_api.log
# Autenticación OAuth2 + JWT (en producción usar una clave larga y aleatoria)
SECRET_KEY=cambiar-esta-clave-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
